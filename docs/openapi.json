{
  "openapi": "3.0.0",
  "info": {
    "title": "Enterprise E-Commerce REST API Specs",
    "version": "1.0.0",
    "description": "API Contracts for Auth, Products, Cart, Orders, Payments, Shipping, and Admin"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": { "summary": "Authenticate User", "responses": { "200": { "description": "Tokens issued" } } }
    },
    "/api/v1/products": {
      "get": { "summary": "List & Filter Products", "responses": { "200": { "description": "Paginated product list" } } }
    },
    "/api/v1/cart": {
      "post": { "summary": "Add item to shopping cart", "responses": { "200": { "description": "Updated cart totals" } } }
    },
    "/api/v1/orders": {
      "post": { "summary": "Checkout and create order", "responses": { "201": { "description": "Order created" } } }
    }
  }
}
